# Server Configuration
PORT=3001
NODE_ENV=development

# Local services (start with: docker compose up -d mongodb redis)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=localdev
MONGO_PORT=27017
MONGODB_URI=mongodb://admin:localdev@localhost:27017/cv-evaluation?authSource=admin
REDIS_URL=redis://localhost:6379

# Frontend origin for local development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OpenAI Configuration
# Optional; empty uses the backend's mock LLM implementation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
LLM_TEMPERATURE=0.3
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=1000

# Pinecone Vector Database
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=cv-evaluation

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain
UPLOAD_DIR=uploads

# Queue Configuration
QUEUE_CONCURRENCY=2
EVALUATION_TIMEOUT=300000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
