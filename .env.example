# Server Configuration
PORT=3001
NODE_ENV=development

# Local services (start with: docker compose up -d mongodb redis)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=localdev
MONGO_PORT=27017
MONGODB_URI=mongodb://admin:localdev@localhost:27017/cv-evaluation?authSource=admin
REDIS_URL=redis://localhost:6379

# Frontend origin for local development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Account authentication
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
# Comma-separated trusted admin emails. An email account is promoted only after verification.
ADMIN_EMAILS=
EMAIL_FROM=Landly <noreply@example.com>
# Keep smtp for local development with Mailpit; set resend on VPS.
EMAIL_PROVIDER=smtp
# Mailpit defaults for local development (SMTP 1025, inbox UI 8025).
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com

# Sumopod OpenAI-compatible API
# Add your own key from the Sumopod dashboard; don't commit it
SUMOPOD_API_KEY=
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1
SUMOPOD_MODEL=glm-5.3-flash
LLM_TEMPERATURE=0.3
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=1000

# Pinecone Vector Database
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=cv-evaluation

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain
UPLOAD_DIR=uploads

# Queue Configuration
QUEUE_CONCURRENCY=2
EVALUATION_TIMEOUT=300000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
